# ==============================================================
# relay.env.example — Template Environment Variables
# ==============================================================
# CARA PAKAI:
#   1. Copy file ini: cp relay.env.example relay.env
#   2. Isi nilai yang sesuai di relay.env
#   3. JANGAN commit relay.env ke git! (sudah ada di .gitignore)
#
# File ini aman untuk di-commit karena hanya berisi CONTOH,
# bukan nilai sebenarnya.
# ==============================================================

# ---------------------------------------------------------------
# DATABASE — PostgreSQL (server terpisah)
# Ganti dengan detail PostgreSQL Anda
# Format: jdbc:postgresql://HOST:PORT/NAMA_DATABASE
# ---------------------------------------------------------------
DB_URL=jdbc:postgresql://IP_SERVER_DB:5432/relay_db
DB_USERNAME=postgres
DB_PASSWORD=ganti_dengan_password_anda

# ---------------------------------------------------------------
# REDIS (akan dijalankan via docker-compose di server)
# Nama service "redis" otomatis resolve dalam Docker network
# ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------
# JWT — Gunakan string panjang & acak (min 32 karakter)
# Generate dengan: openssl rand -base64 64
# ---------------------------------------------------------------
JWT_SECRET=ganti_dengan_secret_panjang_dan_acak_min_32_karakter
JWT_EXPIRY_DAYS=3
JWT_ISSUER=relay

# ---------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------
SERVER_PORT=8080
